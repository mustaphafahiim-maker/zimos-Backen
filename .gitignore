# Dependencies
node_modules/

# Environment files
.env
.env.local
.env.*.local
.env.*
# The template: variable names and comments only, never a value
!.env.example
# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage output
coverage/

# Local archives / backups (not source)
*.zip

# Personal working notes, not part of the project
PHASE_PLAN.md

# Editor / OS
.DS_Store
.idea/
.vscode/
Thumbs.db

# Uploaded media (kept locally, never committed)
public/uploads/*
!public/uploads/.gitkeep

wipe-db.js

# Sample PDFs from scripts/waybill-samples.js
waybill-samples/

# Shoppers' photos on local disk (STORAGE_PROVIDER=local): private, never served or committed
storage/private/

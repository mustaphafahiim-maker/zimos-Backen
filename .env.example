# Zimos backend — environment template.
# Copy to `.env` for local development. Nothing here is a real credential.
# Every value below matches the default the code falls back to (src/config/env.js)
# unless marked otherwise.

# ---- App ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
API_VERSION=v1
# Storefront subdomain routing: <workspace-slug>.<PLATFORM_ROOT_DOMAIN>
PLATFORM_ROOT_DOMAIN=zimos.test
# Where the Google OAuth callback sends the browser (merchant dashboard).
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS (dashboard, admin, storefront, marketing).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001

# ---- Database -------------------------------------------------------------
# Option A: separate vars (local dev).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zimos_dev
DB_NAME_TEST=zimos_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
# Option B: a single URL (Railway / Heroku). When set it overrides the DB_* vars
# except under NODE_ENV=test. Append ?sslmode=require for TLS.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Auth / JWT -----------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_32chars
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (optional). Redirect URI must match the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
STOREFRONT_IP_RATE_LIMIT_MAX=500
STOREFRONT_SERVER_RATE_LIMIT_MAX=5000
# Shared secret between the API and the Next.js storefront server (>= 32 chars
# or boot fails). Leave empty locally. Same value goes in the storefront's
# STOREFRONT_PROXY_SECRET.
STOREFRONT_PROXY_SECRET=
# Comma-separated IPs/CIDRs of our own storefront server (raises its IP limit).
STOREFRONT_SERVER_IP=

# ---- Notifications --------------------------------------------------------
# console (default: log + persist to notification_logs) | brevo
EMAIL_PROVIDER=console
# console | twilio
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Brevo (EMAIL_PROVIDER=brevo)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Zimos
# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Media storage --------------------------------------------------------
# local (writes to public/uploads) | r2 (Cloudflare R2 — use this in production)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the bucket, no trailing slash, e.g. https://pub-abc123.r2.dev
R2_PUBLIC_URL=

# ---- Payments / webhooks --------------------------------------------------
# mock | cod  (see src/modules/payments/providers/)
PAYMENTS_DEFAULT_PROVIDER=mock
WEBHOOK_SIGNING_ALGO=sha256

# HMAC-SHA256 secret for POST /api/v1/billing/webhook (header X-Zimos-Signature).
# Without it every billing webhook is refused.
BILLING_WEBHOOK_SECRET=

# Encrypts merchant integration secrets (WhatsApp tokens…) at rest. Required in production.
INTEGRATIONS_ENCRYPTION_KEY=
# Public base URL of this API (for webhook URLs shown to merchants), e.g. https://api.zimos.app
PUBLIC_API_URL=

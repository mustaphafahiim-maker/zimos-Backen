# Zimos backend — environment template.
# Copy to `.env` for local development, then fill in the secrets marked
# REQUIRED. This file holds variable names and comments only: no secret has a
# value here, and none should ever be committed. Every non-secret value below
# matches the default the code falls back to (src/config/env.js) unless marked
# otherwise.

# ---- App ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
API_VERSION=v1
# Storefront subdomain routing: <workspace-slug>.<PLATFORM_ROOT_DOMAIN>
PLATFORM_ROOT_DOMAIN=zimos.test
# A merchant's root domain (ahmedstore.com) cannot take a CNAME: the addresses its A
# records point at, comma-separated (modules/domains/rootDomains.js). Unset: an ALIAS only.
PLATFORM_APEX_IPS=
# Merchant custom domains (modules/domains, item 341). Unset keeps each default:
# ENABLED: any value but true closes every dashboard route under
#   /workspaces/:id/domains (404) and the domains jobs; verified domains keep
#   resolving. Unset = open.
# SUBDOMAINS_ONLY: true refuses root domains (connect www.<domain> instead) for
#   connecting and buying. Unset = roots allowed.
# CNAME_TARGET: the one host every domain points at (the Cloudflare for SaaS
#   entry). Unset = each store's <slug>.<PLATFORM_ROOT_DOMAIN>.
# MAX_PER_STORE: domains one store may hold, verified or not. Unset = the plan's limit only.
# PENDING_TTL_DAYS: an unverified domain expires after this many days. Unset = never.
# DOMAIN_VERIFY_RESOLVERS: public DNS servers for verification and the DNS check,
#   comma-separated. Unset or blank = 1.1.1.1,8.8.8.8; system = this server's own resolver.
CUSTOM_DOMAINS_ENABLED=
CUSTOM_DOMAINS_SUBDOMAINS_ONLY=
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAINS_MAX_PER_STORE=
CUSTOM_DOMAINS_PENDING_TTL_DAYS=
DOMAIN_VERIFY_RESOLVERS=
# Certificates for merchant domains (modules/domains/certificates): sandbox
# (unset outside production) or cloudflare = Cloudflare for SaaS custom
# hostnames; the token needs Zone > SSL and Certificates: Edit on the platform
# zone only.
CERTIFICATE_PROVIDER=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Where the Google OAuth callback sends the browser (merchant dashboard), and
# the base of emailed links (password reset). Required in production: without
# it password reset answers 503 PASSWORD_RESET_UNAVAILABLE.
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS (dashboard, admin, storefront, marketing).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001

# ---- Database -------------------------------------------------------------
# Option A: separate vars (local dev).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zimos_dev
DB_NAME_TEST=zimos_test
DB_USER=postgres
# REQUIRED unless DATABASE_URL carries a password, in every environment (test
# too: it is the local database's own password). There is no default: the app,
# the migration CLI and docker-compose refuse to start without it.
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
# Option B: a single URL (Railway / Heroku). When set it overrides the DB_* vars
# except under NODE_ENV=test. Append ?sslmode=require for TLS.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Auth / JWT -----------------------------------------------------------
# REQUIRED in every environment: the code has no fallback and refuses to start
# without it (production also refuses one under 32 characters or a dev_only_ /
# change_me placeholder). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
# REQUIRED in production only (same rules). Nothing signs with it: refresh
# tokens are random strings stored hashed.
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (optional). Redirect URI must match the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Google Sheets sync (src/modules/sheets/adapters/README.md). sandbox (default,
# not in production) or google. The google adapter is unavailable (503
# SHEETS_UNAVAILABLE) until all three keys below are set; the redirect URI is
# the dashboard page registered on the OAuth client (e.g. …/apps/google-sheets).
GOOGLE_SHEETS_PROVIDER=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=
# Local stand-ins for Google's hosts, outside production only:
# GOOGLE_SHEETS_AUTH_BASE= GOOGLE_SHEETS_OAUTH2_BASE= GOOGLE_SHEETS_API_BASE= GOOGLE_SHEETS_DRIVE_BASE=

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Sign-in, sign-up, password reset and resend-verification per IP alone, on
# top of AUTH_RATE_LIMIT_MAX (whose key includes the email sent, so a new email
# got a new allowance). Sign-in counts failed attempts only. Everyone behind one
# IP (an office, a mobile carrier) shares it. Unset: 50 per 15 minutes (900000).
AUTH_IP_RATE_LIMIT_MAX=
AUTH_IP_RATE_LIMIT_WINDOW_MS=
# Password reset requests (POST /auth/password-reset/request) per IP per hour.
# Unset: 10. Each account also gets at most 3 links an hour, 10 a day (silently).
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=
# The 6-digit sign-up and confirmation codes, per IP, counted in the database
# over every code sent from that IP (sign-up, sign-in while unconfirmed, the
# resend button, confirming a signed-in account's email). Everyone behind one
# IP shares them. Unset: 20 an hour, 50 a day, 5 SMS a day; anything but a
# whole number of 1 or more refuses to start. Per address and per account stay fixed.
VERIFICATION_CODES_PER_IP_PER_HOUR=
VERIFICATION_CODES_PER_IP_PER_DAY=
VERIFICATION_SMS_PER_IP_PER_DAY=
# Public endpoints that can be closed. REVIEWS_PUBLIC_SUBMISSION_ENABLED: the
# storefront's review form (order number + phone); unset = open, any value but
# true closes it (404 for every request; reading, moderation and ratings are
# unaffected). PASSWORD_RESET_SMS_ENABLED: password reset by SMS code; closed
# unless exactly true (closed = the same answer for any number, nothing sent).
REVIEWS_PUBLIC_SUBMISSION_ENABLED=
PASSWORD_RESET_SMS_ENABLED=
# Changing an account's phone number from the dashboard's account settings by
# an SMS code to the new number. Only the exact value true opens it; closed,
# every request gets the same answer and nothing is sent. Needs real SMS
# (SMS_PROVIDER=twilio and its keys) in production; the console provider is
# refused there.
PHONE_CHANGE_ENABLED=
STOREFRONT_IP_RATE_LIMIT_MAX=500
STOREFRONT_SERVER_RATE_LIMIT_MAX=5000
# Public order tracking (GET /api/v1/store/:id/orders/track), keyed on the
# shopper's phone rather than their IP. _MAX is per phone + order number (one
# lookup being retried); _PHONE_MAX caps how many different order numbers can
# be tried against one phone, which is what actually bounds enumeration.
TRACKING_RATE_LIMIT_WINDOW_MS=600000
TRACKING_RATE_LIMIT_MAX=3
TRACKING_PHONE_RATE_LIMIT_MAX=30
# Storefront search suggestions, per shopper.
SUGGEST_RATE_LIMIT_PER_MINUTE=60
SUGGEST_RATE_LIMIT_PER_HOUR=1200
# "Is this username free?" (GET /auth/username-available), per IP.
USERNAME_CHECK_RATE_LIMIT_PER_MINUTE=20
USERNAME_CHECK_RATE_LIMIT_PER_HOUR=200
# The public plan list (GET /plans/public), per IP.
PUBLIC_PLANS_RATE_LIMIT_PER_MINUTE=60
# Sign-up codes (POST /auth/verify/send and /confirm), per IP.
VERIFY_RATE_LIMIT_PER_MINUTE=10
# Shared secret between the API and the Next.js storefront server (>= 32 chars
# or boot fails). Leave empty locally. Same value goes in the storefront's
# STOREFRONT_PROXY_SECRET.
STOREFRONT_PROXY_SECRET=
# Comma-separated IPs/CIDRs of our own storefront server (raises its IP limit).
STOREFRONT_SERVER_IP=

# The client IP behind Cloudflare (src/core/middleware/clientIp.js). Off by
# default (empty): the client IP is req.ip, from X-Forwarded-For with trust
# proxy 1.
# CLIENT_IP_DEBUG=true logs, per request, X-Forwarded-For, CF-Connecting-IP,
# X-Real-IP and req.ip, and whether the edge secret matched (never its value).
CLIENT_IP_DEBUG=
# TRUST_EDGE_CLIENT_IP=true takes CF-Connecting-IP as the client IP, but only
# on a request carrying EDGE_SECRET_HEADER with the value EDGE_SECRET (a
# Cloudflare Transform Rule adds it); anything else keeps req.ip. With it on,
# the app refuses to start without an "x-" header name the app doesn't already
# read, or with a secret under 32 characters:
#   openssl rand -hex 32
TRUST_EDGE_CLIENT_IP=
EDGE_SECRET_HEADER=
EDGE_SECRET=

# ---- Notifications --------------------------------------------------------
# console (default: log + persist to notification_logs) | brevo
EMAIL_PROVIDER=console
# console | twilio
SMS_PROVIDER=console
# console (development; counts as not configured in production) or cloud — src/modules/notifications/PLATFORM_WHATSAPP.md
WHATSAPP_PROVIDER=console
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_PLATFORM_TOKEN=
# WHATSAPP_CODE_TEMPLATE=zimos_code
# The code template's language codes (unset: ar / en_US).
WHATSAPP_CODE_LANG_AR=
WHATSAPP_CODE_LANG_EN=
# Teammates' notifications on WhatsApp (utility template, see PLATFORM_WHATSAPP.md)
# WHATSAPP_ALERT_TEMPLATE=zimos_alert
# Its language code (unset: ar).
WHATSAPP_ALERT_LANG=
# The Graph API base for WhatsApp Cloud (unset: https://graph.facebook.com/v21.0).
WHATSAPP_GRAPH_BASE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Brevo (EMAIL_PROVIDER=brevo)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Zimos
# Store sending domains (src/modules/emailDomains/README.md): sandbox (default, not in
# production) or brevo (automatic in production when BREVO_API_KEY is set).
EMAIL_DOMAIN_PROVIDER=
# Local stand-in for api.brevo.com (domains and email), outside production only.
# BREVO_API_BASE=
# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Delivery status webhooks (src/modules/notifications/deliveryStatus/README.md).
# The secret Brevo's webhook sends (long random string; Bearer token, basic-auth password or ?token=).
BREVO_WEBHOOK_TOKEN=
# This API's public origin (https://api.example.com): SMS get a Twilio statusCallback only when set.
NOTIFICATIONS_WEBHOOK_BASE_URL=
# Outside production only: console sends get simulated delivery statuses (README).
NOTIFICATION_STATUS_SIMULATION=
# Push (src/modules/notifications/push/README.md). PUSH_PROVIDER unset = webpush when
# both VAPID keys are set, else sandbox outside production; production without keys sends no push.
PUSH_PROVIDER=
# Web Push VAPID pair: node scripts/generate-vapid-keys.js (once per environment). The private key is a secret.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# mailto: address or https: URL the browsers' push services can contact.
WEB_PUSH_SUBJECT=
# Extra push service hostnames allowed as endpoints, comma-separated (testing or self-hosted). Unset = the browsers' own.
WEB_PUSH_EXTRA_HOSTS=

# ---- Media storage --------------------------------------------------------
# local (writes to public/uploads) | r2 (Cloudflare R2 — use this in production)
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the bucket, no trailing slash, e.g. https://pub-abc123.r2.dev
R2_PUBLIC_URL=
# Optional private bucket for shoppers' photos (unset: the media bucket under
# customer-uploads/, never linked publicly).
R2_PRIVATE_BUCKET_NAME=

# Photos shoppers attach to an order (POST /store/:workspaceId/uploads).
CUSTOMER_UPLOAD_MAX_PENDING=10
CUSTOMER_UPLOAD_TTL_HOURS=48
# 0 turns the in-process sweep off (scripts/sweep-customer-uploads.js still works).
CUSTOMER_UPLOAD_SWEEP_MINUTES=30
CUSTOMER_UPLOAD_IP_PER_MINUTE=20
CUSTOMER_UPLOAD_IP_PER_HOUR=120
CUSTOMER_UPLOAD_VISITOR_PER_MINUTE=8
CUSTOMER_UPLOAD_VISITOR_PER_HOUR=40
# Signs the short-lived links the dashboard shows those photos through. Unset:
# derived from JWT_ACCESS_SECRET.
UPLOAD_URL_SECRET=
UPLOAD_URL_TTL_SECONDS=900

# ---- Payments / webhooks --------------------------------------------------
# No longer read by the app (manual payments pick their provider from the
# order's payment method). Kept so existing deployments that set it are unaffected.
PAYMENTS_DEFAULT_PROVIDER=mock
WEBHOOK_SIGNING_ALGO=sha256

# Online payments through the merchant's own gateway account. Off by default:
# the storefront stays cash on delivery only.
PAYMENTS_ONLINE_ENABLED=false
PAYMENT_ATTEMPT_TTL_MINUTES=30
# A kiosk payment waits longer for the shopper to pay in cash (minutes).
PAYMENT_KIOSK_TTL_MINUTES=2880
PAYMENT_MAX_ATTEMPTS_PER_ORDER=5
PAYMENT_WEBHOOK_RATE_LIMIT_MAX=300
# Extra hosts a shopper may be sent back to after paying (comma-separated).
PAYMENT_RETURN_HOSTS=
PAYMOB_BASE_URL=https://accept.paymob.com
# Kashier API / checkout hosts per mode (defaults shown).
KASHIER_TEST_API_URL=https://test-api.kashier.io
KASHIER_LIVE_API_URL=https://api.kashier.io
KASHIER_TEST_FEP_URL=https://test-fep.kashier.io
KASHIER_LIVE_FEP_URL=https://fep.kashier.io

# HMAC-SHA256 secret for POST /api/v1/billing/webhook (header X-Zimos-Signature).
# Without it every billing webhook is refused.
BILLING_WEBHOOK_SECRET=

# Paying a subscription charge online through Fawaterak (Zimos's own account,
# not a store's, docs/billing-fawaterak.md). ONLINE_BILLING_ENABLED=true lets
# merchants start a payment; anything else leaves it off, and recording a
# payment by hand works either way. FAWATERAK_ENV: staging | live (default
# staging). FAWATERAK_BASE_URL and FAWATERAK_TOKEN_URL are optional overrides.
# FAWATERAK_WEBHOOK_TOKEN: ours, at least 32 characters. Never commit values;
# set them on the host.
ONLINE_BILLING_ENABLED=
FAWATERAK_ENV=staging
FAWATERAK_BASE_URL=
FAWATERAK_TOKEN_URL=
FAWATERAK_CLIENT_ID=
FAWATERAK_CLIENT_SECRET=
FAWATERAK_HASH_KEY=
FAWATERAK_WEBHOOK_TOKEN=

# Plan features as a gate. Only the exact value true turns it on; anything
# else is off and nothing is refused for a missing feature, as before. On:
# adding, buying or verifying a custom domain needs custom_domain, inviting a
# team member needs staff_accounts and the web analytics need
# advanced_analytics, from the store's plan or a console override (403
# PLAN_FEATURE_REQUIRED). A plan that doesn't list custom_domain stops its
# stores from connecting a domain unless the console grants it to the store.
PLAN_FEATURE_ENFORCEMENT=

# The prepaid balance and the pay-per-order plan (docs/billing-wallet.md).
# Only the exact value true turns it on; anything else is off: no order fee,
# no plan with a fee offered, no top-up — as before it existed. Its limits
# (top-up minimum and maximum, overdraft, open top-ups) are constants in
# src/modules/billing/walletService.js, not variables. Keep it off until the
# terms and refund policy for prepaid money are settled.
WALLET_ENABLED=

# enforce | warn. What an unpaid subscription does one day after its period
# ends: enforce makes the storefront unavailable and blocks new products and
# funnels; warn only shows the dashboard banners. Unset: warn in production,
# enforce elsewhere. Manual suspensions are enforced regardless.
BILLING_RESTRICTIONS=

# Sign-up and go-live rules (modules/auth/signupPolicy.js): only the exact
# value true turns each on.
REQUIRE_PLAN_AT_SIGNUP=
REQUIRE_SIGNUP_VERIFICATION=
REQUIRE_SUBSCRIPTION_TO_GO_LIVE=
# New accounts signed in at once, confirming their email with a code instead
# of the link (with REQUIRE_SIGNUP_VERIFICATION off), and sign-up asking for a
# phone. Same rule: only true turns each on.
SIGNUP_CONFIRM_BY_CODE=
REQUIRE_PHONE_AT_SIGNUP=
# Draft stores one person may hold while none of their stores is live.
DRAFT_STORES_PER_USER=1
# Country calling codes a verification SMS may go to (digits, comma-separated).
VERIFICATION_SMS_COUNTRY_CODES=20
# How a merchant pays while there is no gateway, shown next to the subscribe
# button. Plain text; empty hides the block.
PAYMENT_INSTRUCTIONS_AR=
PAYMENT_INSTRUCTIONS_EN=

# Merchant courier and payment-gateway credentials are entered per store and
# encrypted with these keys (32 bytes, base64: openssl rand -base64 32). Unset
# means the feature answers 503. See src/core/utils/credentialsCipher.js.
CARRIER_CREDENTIALS_KEY=
GATEWAY_CREDENTIALS_KEY=
# Carrier status webhooks, per merchant webhook token per RATE_LIMIT_WINDOW_MS.
CARRIER_WEBHOOK_RATE_LIMIT_MAX=300
# Which courier adapters exist on this server (comma-separated codes).
# CARRIERS_ENABLED: every store (unset = bosta; set but empty = none).
# CARRIERS_BETA: only the stores whose slugs are in CARRIERS_BETA_WORKSPACES.
CARRIERS_ENABLED=bosta
CARRIERS_BETA=
CARRIERS_BETA_WORKSPACES=
# scripts/sync-carrier-shipments.js: shipments per batch, and how many days
# after booking a shipment is still polled.
CARRIER_SYNC_BATCH_SIZE=200
CARRIER_POLL_MAX_AGE_DAYS=45
# Item 183: point Stripe / PayPal at a mock store outside production (unset = the real hosts;
# PayPal sandbox or live is detected from the merchant's keys).
# STRIPE_API_BASE=http://127.0.0.1:4198
# PAYPAL_API_BASE=http://127.0.0.1:4198

# Meta Graph API version used for server-side Conversions API events
# (per-workspace pixel id + access token, entered in Settings and encrypted —
# never here). Bump this as older versions sunset; v21.0 is still valid.
# META_GRAPH_API_VERSION=v21.0

# Encrypts merchant integration secrets (WhatsApp tokens…) at rest. Required in production.
INTEGRATIONS_ENCRYPTION_KEY=
# Public base URL of this API (for webhook URLs shown to merchants), e.g. https://api.zimos.app
PUBLIC_API_URL=

# Background jobs (core/queue). Without REDIS_URL the queue runs on PostgreSQL.
# The API runs the worker itself unless WORKER_IN_PROCESS=false, in which case
# start one with: npm run worker
REDIS_URL=
WORKER_IN_PROCESS=true
QUEUE_POLL_MS=1000
QUEUE_CONCURRENCY=10
# A job whose worker stopped is handed out again (or failed, if it may not run
# twice) once its lock is this old. Running jobs renew it every minute.
QUEUE_STALE_LOCK_MS=600000

# Outbound webhooks to merchants' systems. The API sends them itself unless
# WEBHOOKS_IN_PROCESS=false (then run scripts/dispatch-webhooks.js from a cron).
WEBHOOKS_IN_PROCESS=true
WEBHOOKS_INTERVAL_MS=5000
WEBHOOKS_TIMEOUT_MS=10000
WEBHOOKS_BATCH_SIZE=50
# Private addresses (localhost, 10/8, …) as webhook targets. Unset: allowed
# outside production only. Left commented: set but empty means "false".
# WEBHOOKS_ALLOW_PRIVATE_URLS=

# Refresh token as an httpOnly cookie for the dashboards (off = in the JSON
# body, kept in localStorage). On by default outside production; in production
# set it to true once the dashboard and the API share a site (app.x + api.x).
# Left commented: set but empty means "off".
# AUTH_REFRESH_COOKIE=
AUTH_COOKIE_SAMESITE=lax
# Production refuses to start with STORAGE_PROVIDER=local unless this is true.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=

# Error reporting (core/errors/errorReporter.js). Unset = the log only.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Storefront read cache (modules/storefront/storefrontCache.js), in Redis when
# REDIS_URL is set. 0 turns it off.
STOREFRONT_CACHE_TTL_SECONDS=60

# The sandbox courier (modules/shipping/carriers/sandbox.js) exists outside
# production. In production it needs this and the FeatureFlag
# sandbox_integrations on for the store.
CARRIERS_SANDBOX=

# Storefront analytics: CDNs whose geo headers (country/region/city) the event
# ingest may trust, comma-separated: cloudflare, vercel, cloudfront. Leave
# empty unless this API really sits behind that CDN. Empty: no visitor geo.
ANALYTICS_GEO_HEADERS=
# Anonymous marketing-site visits for the console (POST /public/site-events,
# no IP and no cookie kept). Only the exact value true opens it; closed, the
# endpoint answers 404 and sign-up ignores siteSessionId. ORIGINS is that
# endpoint's own CORS list (comma-separated, no trailing slash, e.g.
# https://zimos.co). Country comes from CF-IPCountry only when
# ANALYTICS_GEO_HEADERS includes cloudflare.
SITE_ANALYTICS_ENABLED=
SITE_ANALYTICS_ORIGINS=

# COD confirmation queue: how long a claimed task stays locked to one agent
# before it returns to Pending on its own (minutes).
CONFIRMATION_LOCK_TTL_MINUTES=15

# A shipment status set by hand that would move the order to a stage the stage
# table does not allow is refused (409 INVALID_STATUS_TRANSITION). Unset: on.
# Only the exact value false turns it off; the move is then recorded like any
# other. PATCH /orders/:id/status checks the table either way.
ORDER_STATUS_GUARDS=

# Checkout bot guard for stores that have not set their own, outside
# production: on / off (unset: off). Production: always on.
BOT_PROTECTION_DEFAULT=
# Checkout captcha (modules/risk/captcha/README.md): the name of a registered
# verifier (sandbox: outside production only). Unset: no captcha.
# TURNSTILE_SITE_KEY is the public key a Turnstile adapter sends to the storefront.
CAPTCHA_PROVIDER=
TURNSTILE_SITE_KEY=
# IP reputation (modules/risk/ipIntel/README.md). Unset: the sandbox outside
# production, none in production.
IP_INTEL_PROVIDER=
